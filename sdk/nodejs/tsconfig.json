{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "apiToken.ts",
        "config/index.ts",
        "config/vars.ts",
        "contextField.ts",
        "environment.ts",
        "getContextField.ts",
        "getEnvironment.ts",
        "getGroup.ts",
        "getPermission.ts",
        "getProject.ts",
        "getProjectEnvironment.ts",
        "getRole.ts",
        "getUser.ts",
        "group.ts",
        "index.ts",
        "oidc.ts",
        "project.ts",
        "projectAccess.ts",
        "projectEnvironment.ts",
        "provider.ts",
        "role.ts",
        "saml.ts",
        "serviceAccount.ts",
        "serviceAccountToken.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "user.ts",
        "utilities.ts"
    ]
}
